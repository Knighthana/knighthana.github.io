#!/usr/bin/env bash
# =============================================================================
# manager - 博客本地环境管理工具
# 新架构说明：仓库只存原料（raw/ builder/ external/），部署由 GitHub Actions
# 自动完成（hexo generate + deploy-pages）。本地脚本只负责环境准备与预览。
#
# 用法:
#   ./bin/manager setup [--dry-run]   首次安装配置（fnm/Node/npm 依赖）
#   ./bin/manager preview              启动本地预览（hexo server）
#   ./bin/manager help                 显示帮助
# =============================================================================

set -euo pipefail

# ------------------------------ 全局变量 ------------------------------------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
DRY_RUN=0

# 默认值（用户可覆盖）
DEFAULT_FNM_URL="https://fnm.vercel.app/install"
DEFAULT_NODE_MIRROR="https://mirrors.cernet.edu.cn/nodejs-release/"
DEFAULT_NPM_MIRROR="https://registry.npmmirror.com"
DEFAULT_NODE_VERSION="latest"

# ------------------------------ 辅助函数 ------------------------------------
log_info()  { echo "[INFO]  $*"; }
log_warn()  { echo "[WARN]  $*" >&2; }
log_error() { echo "[ERROR] $*" >&2; }
log_dry()   { [ "$DRY_RUN" -eq 1 ] && echo "[DRY RUN] $*" || true; }

# 执行命令（干跑模式下仅打印）
execute() {
    if [ "$DRY_RUN" -eq 1 ]; then
        echo "[DRY RUN] $*"
        return 0
    else
        eval "$@"
    fi
}

# 检测 Linux 发行版（用于给出安装建议）
detect_distro() {
    if command -v apt &>/dev/null; then
        echo "debian"
    elif command -v dnf &>/dev/null; then
        echo "fedora"
    elif command -v pacman &>/dev/null; then
        echo "arch"
    elif command -v choco &>/dev/null; then
        echo "msys2"
    else
        echo "unknown"
    fi
}

# 打印软件安装建议
print_install_help() {
    local pkg="$1"
    local distro="$(detect_distro)"
    echo "请安装 $pkg："
    case "$distro" in
        debian) echo "  sudo apt install $pkg" ;;
        fedora) echo "  sudo dnf install $pkg" ;;
        arch)   echo "  sudo pacman -S $pkg" ;;
        msys2)  echo "  pacman -S $pkg" ;;
        *)      echo "  请使用您系统的包管理器安装 $pkg" ;;
    esac
}

# ------------------------------ setup ------------------------------------
do_setup() {
    log_info "开始环境检查与配置..."

    # ---------- 阶段1：依赖检查 ----------
    if ! command -v pandoc &>/dev/null; then
        log_error "pandoc 未安装，这是 hexo-renderer-pandoc 必需组件"
        print_install_help pandoc
        exit 1
    fi
    log_info "pandoc 已安装 ✓"

    # 仅当 fnm 未安装时检查下载依赖
    if ! command -v fnm &>/dev/null; then
        log_info "fnm 未安装，检查下载依赖..."
        if ! command -v curl &>/dev/null; then
            log_warn "curl 未安装"
            print_install_help curl
        fi
        if ! command -v unzip &>/dev/null; then
            log_warn "unzip 未安装"
            print_install_help unzip
        fi
    else
        log_info "fnm 已安装 ✓"
    fi

    # ---------- 阶段2：安装 fnm（如需要） ----------
    if ! command -v fnm &>/dev/null; then
        log_info "安装 fnm..."
        execute "bash -c 'curl -fsSL \"$DEFAULT_FNM_URL\" | bash'"
    fi

    # ---------- 阶段3：配置 Node 镜像并安装 ----------
    log_info "配置 shell 环境变量 FNM_NODE_DIST_MIRROR..."
    local profile_file
    if [[ "${SHELL:-}" == *"zsh"* ]]; then
        profile_file="$HOME/.zprofile"
    else
        profile_file="$HOME/.profile"
    fi
    if [ "$DRY_RUN" -eq 1 ]; then
        log_dry "将向 $profile_file 添加: export FNM_NODE_DIST_MIRROR=\"$DEFAULT_NODE_MIRROR\""
    else
        if grep -q "export FNM_NODE_DIST_MIRROR=" "$profile_file" 2>/dev/null; then
            sed -i.bak "s|^export FNM_NODE_DIST_MIRROR=.*|export FNM_NODE_DIST_MIRROR=\"$DEFAULT_NODE_MIRROR\"|" "$profile_file"
        else
            echo "" >> "$profile_file"
            echo "# Added by Blog manager" >> "$profile_file"
            echo "export FNM_NODE_DIST_MIRROR=\"$DEFAULT_NODE_MIRROR\"" >> "$profile_file"
        fi
        log_info "已写入 $profile_file"
    fi
    export FNM_NODE_DIST_MIRROR="$DEFAULT_NODE_MIRROR"

    log_info "安装 Node $DEFAULT_NODE_VERSION ..."
    if command -v fnm &>/dev/null; then
        execute "fnm install $DEFAULT_NODE_VERSION"
        execute "fnm use $DEFAULT_NODE_VERSION"
    fi

    # ---------- 阶段4：验证 Node/npm ----------
    log_info "验证 Node/npm..."
    if [ "$DRY_RUN" -eq 1 ]; then
        log_dry "将执行: node --version && npm --version"
    else
        if ! node --version &>/dev/null || ! npm --version &>/dev/null; then
            log_error "Node/npm 验证失败"
            exit 1
        fi
        log_info "Node: $(node --version) ✓"
        log_info "npm:  $(npm --version) ✓"
    fi

    # ---------- 阶段5：设置项目级 npm registry ----------
    log_info "设置项目级 npm registry..."
    if ! grep -q "^registry=" "$PROJECT_ROOT/.npmrc" 2>/dev/null; then
        echo "registry=$DEFAULT_NPM_MIRROR" >> "$PROJECT_ROOT/.npmrc"
        log_info "已写入 $PROJECT_ROOT/.npmrc"
    else
        log_info ".npmrc 已存在 registry 配置，跳过"
    fi

    # ---------- 阶段6：安装项目依赖 ----------
    log_info "安装项目依赖 (npm ci)..."
    cd "$PROJECT_ROOT"
    execute "npm ci"

    log_info "✅ 环境准备完成！"
    log_info "本地预览: cd builder && npx hexo server"
    log_info "发布: 直接 git push，GitHub Actions 会自动构建部署，无需本地构建。"
}

# ------------------------------ preview ------------------------------------
do_preview() {
    cd "$PROJECT_ROOT"
    if [ ! -d node_modules ]; then
        log_warn "node_modules 不存在，先执行 npm ci..."
        execute "npm ci"
    fi
    log_info "启动本地预览: hexo server (Ctrl+C 停止)"
    execute "npx hexo server"
}

# ------------------------------ 主入口 ------------------------------------
show_help() {
    cat <<EOF
用法: $0 <子命令> [选项]

子命令:
  setup [--dry-run]   环境检查与配置（fnm/Node/npm 依赖）
  preview             启动本地预览（hexo server）
  help                显示此帮助

选项:
  --dry-run  仅模拟执行，不实际修改任何文件或系统

示例:
  $0 setup
  $0 setup --dry-run
  $0 preview
EOF
}

# 解析子命令
SUBCOMMAND="${1:-help}"
shift || true

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run) DRY_RUN=1; shift ;;
        --help) show_help; exit 0 ;;
        *) log_error "未知选项: $1"; show_help; exit 1 ;;
    esac
done

case "$SUBCOMMAND" in
    setup)   do_setup ;;
    preview) do_preview ;;
    help)    show_help ;;
    *)       log_error "未知子命令: $SUBCOMMAND"; show_help; exit 1 ;;
esac
